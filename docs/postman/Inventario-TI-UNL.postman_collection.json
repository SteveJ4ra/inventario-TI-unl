              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets/1/deliver/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", "1", "deliver", ""]
            }
          },
          "response": []
