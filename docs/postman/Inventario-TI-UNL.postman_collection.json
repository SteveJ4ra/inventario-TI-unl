              "path": ["api", "assets", "1", "return", ""]
            }
          },
          "response": []
        },
        {
          "name": "Cambio de condición (condition)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expected_revision\": 2,\n  \"note\": \"\",\n  \"condition\": \"averiado\",\n  \"reason\": \"Pantalla rota\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets/1/condition/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", "1", "condition", ""]
            }
          },
          "response": []
        },
        {
          "name": "Rectificación (rectify)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expected_revision\": 3,\n  \"note\": \"\",\n  \"movement_id\": 5,\n  \"reason\": \"Corrección de registro\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets/1/rectify/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assets", "1", "rectify", ""]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Custodios",
      "item": [
        {
          "name": "Listar custodios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/custodians/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "custodians", ""]
            }
          },
          "response": []
        },
        {
          "name": "Crear custodio",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Juan Perez\",\n  \"email\": \"juan@unl.edu.ec\",\n  \"department\": \"TI\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/custodians/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "custodians", ""]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Catálogos",
      "item": [
        {
          "name": "Opciones para formularios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/options/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "options", ""]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Importación CSV",
      "item": [
        {
          "name": "Descargar plantilla",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imports/templates/assets/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "imports", "templates", "assets", ""]
            }
          },
          "response": []
        },
        {
          "name": "Crear vista previa",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "kind", "value": "assets", "type": "text" },
                { "key": "schema_version", "value": "v1", "type": "text" },
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/imports/previews",
              "host": ["{{baseUrl}}"],
              "path": ["api", "imports", "previews"]
            }
          },
          "response": []
        },
        {
          "name": "Consultar lote",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imports/00000000-0000-0000-0000-000000000000?page=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "imports", "00000000-0000-0000-0000-000000000000"],
              "query": [{ "key": "page", "value": "1" }]
            }
          },
          "response": []
        },
        {
          "name": "Confirmar lote",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_hash\": \"pega-aqui-el-content_hash\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/imports/00000000-0000-0000-0000-000000000000/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "imports", "00000000-0000-0000-0000-000000000000", "confirm"]
            }
          },
          "response": []
        },
        {
          "name": "Aplicar lote",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_hash\": \"pega-aqui-el-content_hash\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/imports/00000000-0000-0000-0000-000000000000/apply",
              "host": ["{{baseUrl}}"],
              "path": ["api", "imports", "00000000-0000-0000-0000-000000000000", "apply"]
            }
          },
          "response": []
        },
        {
          "name": "Cancelar lote",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imports/00000000-0000-0000-0000-000000000000/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "imports", "00000000-0000-0000-0000-000000000000", "cancel"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
