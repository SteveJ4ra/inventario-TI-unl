        {
          "name": "Devolución (return)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expected_revision\": 2,\n  \"note\": \"\",\n  \"condition\": \"operativo\",\n  \"reception_location\": \"Bodega\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/assets/1/return/",
