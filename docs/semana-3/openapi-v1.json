            "type": "integer",
            "minimum": 1
          },
          "full_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "department": {
            "type": "string"
          }
        }
      },
      "MovementResult": {
        "type": "object",
        "required": [
