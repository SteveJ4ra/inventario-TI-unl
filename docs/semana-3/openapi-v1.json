{
  "openapi": "3.1.0",
  "info": {
    "title": "Inventario TI: flujo de activos y custodia",
    "version": "1.0.0",
    "description": "Alcance v1 de semana 3. La facultad y el documento de adquisición deben existir; se administran mediante la API anterior. En el alta indique fecha de adquisición o motivo de desconocimiento, exclusivamente. Seguridad de semana 4: sesión con vencimiento absoluto de treinta minutos, sin renovación por consultas; cinco fallos de acceso por cuenta e IP en quince minutos y rechazo posterior con 429."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/csrf/": {
      "get": {
        "summary": "Obtener token CSRF",
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "parameters": [],
        "security": []
      }
    },
    "/auth/login/": {
      "post": {
        "summary": "Iniciar sesión",
        "responses": {
          "200": {
            "description": "Operación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "description": "Acceso o CSRF rechazado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "429": {
            "description": "Se agotaron cinco fallos por combinación de cuenta e IP en una ventana de quince minutos. Esperar el plazo indicado.",
            "headers": {
              "Retry-After": {
                "description": "Segundos restantes de la ventana.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRFToken",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token obtenido con GET /auth/csrf/; requerido para escrituras con sesión."
          }
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "maxLength": 150,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
