            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "assignment": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "condition": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "current_custodian": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "Custodian": {
        "type": "object",
        "required": [
          "id",
          "full_name",
          "email"
        ],
        "properties": {
