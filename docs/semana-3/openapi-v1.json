          }
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "computadora_escritorio",
                      "portatil",
                      "monitor",
                      "impresora",
                      "equipo_red",
                      "periferico"
                    ]
                  },
                  "brand": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "serial_number": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "condition": {
                    "type": "string",
                    "enum": [
                      "operativo",
                      "averiado",
                      "en_reparacion"
                    ]
                  },
                  "item_value": {
                    "type": [
                      "string",
                      "number"
                    ],
                    "description": "Importe decimal con hasta 12 dígitos y dos decimales; los importes no positivos se rechazan con 409 según la política existente."
                  },
                  "acquired_on": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  },
                  "date_unknown_reason": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "faculty_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "acquisition_document_id": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "name",
                  "description",
                  "category",
                  "brand",
                  "model",
                  "serial_number",
                  "location",
                  "condition",
                  "item_value",
                  "faculty_id",
                  "acquisition_document_id"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "acquired_on"
                    ],
                    "properties": {
                      "acquired_on": {
                        "type": "string",
                        "format": "date"
                      },
                      "date_unknown_reason": {
                        "const": ""
                      }
                    }
                  },
                  {
                    "required": [
                      "date_unknown_reason"
                    ],
                    "properties": {
                      "acquired_on": {
                        "type": "null"
                      },
                      "date_unknown_reason": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  }
                ]
              },
              "example": {
                "name": "Portátil de prueba",
                "description": "Equipo para demostración",
                "category": "portatil",
                "brand": "Ejemplo",
                "model": "A1",
                "serial_number": "DEMO-001",
                "location": "Bodega",
                "condition": "operativo",
                "faculty_id": 1,
                "acquisition_document_id": 1,
                "item_value": "300.00",
                "acquired_on": "2026-01-15"
              }
            }
          }
        }
      }
