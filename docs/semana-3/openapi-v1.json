        },
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "computadora_escritorio",
                "portatil",
                "monitor",
                "impresora",
                "equipo_red",
                "periferico"
              ]
            }
          },
          {
            "name": "condition",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "operativo",
                "averiado",
                "en_reparacion"
              ]
            }
          },
          {
            "name": "situation",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "disponible",
                "asignado",
                "no_localizado",
                "baja"
              ]
            }
          },
          {
            "name": "assignment",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "disponible",
                "asignado"
              ]
            }
          },
          {
            "name": "location",
            "in": "query",
